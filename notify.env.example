# canvas-mcp 日报配置（复制为仓库外的 notify.env，路径可用 NOTIFY_ENV 覆盖）。
# 只填字段值，不要加引号也可以；# 开头为注释。切勿把真实密码/令牌提交进仓库。

# --- SMTP（Gmail 需使用「应用专用密码」，不是账号密码）---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
# 发件人 / 收件人，留空则都默认等于 SMTP_USER
MAIL_FROM=
MAIL_TO=

# --- 本地 LLM（LM Studio，OpenAI 兼容端点；只用于公告摘要，可选）---
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL_REPORT=qwen/qwen3.5-9b
# lms 可执行文件路径；留空则用 %USERPROFILE%\.lmstudio\bin\lms.exe
LMS_PATH=

# --- 日报行为 ---
# 没有任何变化且未来 7 天无 DDL 时是否跳过发送（--force 可强制发）
REPORT_SKIP_EMPTY=true
# 目标等级（课程进度里的目标线与"剩余需平均"按它计算）
TARGET_GRADE=A
