# Copy to .env (never commit .env) or set these in your MCP client config.
CANVAS_BASE_URL=https://q.utoronto.ca

# Provide the token one of two ways:
# 1) Path to a file containing only the token (recommended):
CANVAS_TOKEN_FILE=/absolute/path/to/Token.txt
# 2) Or the token itself:
# CANVAS_TOKEN=your-canvas-access-token
